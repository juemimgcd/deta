OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_CONTEXT_WINDOW=

# Optional: keep using Deta normally and send its execution chain to Eyes.
EYES_OBSERVATION_URL=
EYES_OBSERVATION_TOKEN=
# true uploads task/model/tool bodies after known-key redaction; false keeps metadata only.
EYES_CAPTURE_BODY=false

# Local Eyes defaults to http://127.0.0.1:8000; no observation token needed.
# Set false to disable local discovery and buffering.
EYES_OBSERVATION_ENABLED=true
